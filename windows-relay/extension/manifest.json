{
  "manifest_version": 3,
  "name": "GPT One-Click Go Relay",
  "version": "1.1.0",
  "description": "Local bridge for GPT One-Click Go consumer missions and explicit Windows relay actions.",
  "permissions": [
    "storage",
    "activeTab",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1:8766/*",
    "https://chatgpt.com/*",
    "http://127.0.0.1:8767/*"
  ],
  "background": {
    "service_worker": "service_worker.js",
    "type": "module",
    "scripts": [
      "service_worker.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "GPT One-Click Go Relay",
    "default_popup": "popup.html"
  }
}
